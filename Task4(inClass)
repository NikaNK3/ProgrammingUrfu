//show
Console.Write("Вы хотите вывести список? ");
answer3 = Console.ReadLine();
if (answer3 == "д" || answer3 == "да")
{
    Console.Write("Какой список вы хотите вывести (1.Весь 2.Отличники 3.Хорошисты 4.Троечники 5.Двоечники)? ");
    numOfList = int.Parse(Console.ReadLine());

    var five = new List<string>();
    var four = new List<string>();
    var three = new List<string>();
    var two = new List<string>();

    Console.WriteLine("=============================================================================");
    Console.WriteLine($"{"Студент",-30} | {"Оценки",-20} | {"Среднее",8} | {"Категория",-12}");
    Console.WriteLine("=============================================================================");

    foreach (var student in students)
    {
        string[] part = student.Split(";");
        if (part.Length <= 1) continue;

        fio = part[0].ToUpper();
        string marksStr = "";
        int sum = 0;
        int num = part.Length - 1;
        for (int j = 1; j < part.Length; j++)
        {
            marksStr += part[j] + " ";
            sum += int.Parse(part[j]);
        }
        marksStr = marksStr.Trim();

        sr = (double)sum / num;

        int currentCategory = 0;
        string categoryName = "";

        if (sr >= 4.5) { currentCategory = 2; categoryName = "Отличник"; }
        else if (sr >= 3.5) { currentCategory = 3; categoryName = "Хорошист"; }
        else if (sr >= 2.5) { currentCategory = 4; categoryName = "Троечник"; }
        else { currentCategory = 5; categoryName = "Двоечник"; }

        if (numOfList == 1 || numOfList == currentCategory)
        {
            
            Console.WriteLine($"{fio,-30} | {marksStr,-20} | {sr,8:F2} | {categoryName,-12}");
        }
    }
    Console.WriteLine("=============================================================================");
}

